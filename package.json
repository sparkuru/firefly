{
  "name": "f1refly",
  "private": true,
  "scripts": {
    "install:x-core": "npm --prefix packages/x-core ci",
    "check:x-core": "npm --prefix packages/x-core run check",
    "test:x-core": "npm --prefix packages/x-core run test",
    "build:x-core": "npm --prefix packages/x-core run build",
    "install:semantic": "npm --prefix presentations/semantic ci",
    "check:semantic": "npm --prefix presentations/semantic run check",
    "test:semantic": "npm --prefix presentations/semantic run test",
    "build:semantic": "npm --prefix presentations/semantic run build",
    "dev:site": "npm --prefix apps/site run dev",
    "install:site": "npm --prefix apps/site ci",
    "check:site": "npm --prefix apps/site run check",
    "build:site": "npm --prefix apps/site run build",
    "test:content:site": "npm --prefix apps/site run test:content",
    "test:e2e:site": "npm --prefix apps/site run test:e2e",
    "test:x-core:site": "npm --prefix apps/site run test:x-core",
    "build:m2": "npm run build:x-core && npm run build:semantic && npm run build:site",
    "check:m2": "npm run check:x-core && npm run check:semantic && npm run check:site",
    "test:m2": "npm run test:x-core && npm run test:semantic && npm run test:content:site && npm run test:x-core:site",
    "dev:nerv": "npm --prefix experiments/nerv run dev",
    "check:nerv": "npm --prefix experiments/nerv run check",
    "build:nerv": "npm --prefix experiments/nerv run build",
    "test:e2e:nerv": "npm --prefix experiments/nerv run test:e2e"
  }
}
