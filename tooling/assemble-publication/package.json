{
  "name": "@firefly/assemble-publication",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "build": "tsc",
    "assemble": "npm run build --silent && node dist/src/cli.js",
    "build:experiments": "npm run build --silent && node dist/src/cli.js --build-experiments",
    "start:e2e": "node dist/src/serve-release.js",
    "test:e2e": "npm run build --silent && playwright test"
  },
  "dependencies": {
    "@firefly/validate-experiments": "file:../validate-experiments"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.3.0",
    "typescript": "6.0.3"
  }
}
