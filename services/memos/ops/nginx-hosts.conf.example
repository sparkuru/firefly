# Install only in the matching owner-managed HTTPS server block.
# Replace HOSTNAME and TLS paths; this file does not configure real-IP trust.
server {
    listen 443 ssl;
    server_name HOSTNAME;
    ssl_certificate /OWNER/TLS/certificate.pem;
    ssl_certificate_key /OWNER/TLS/private-key.pem;

    location ^~ /v1/memos/ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
    location ^~ /v1/ {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        return 404 '{"status":"not_found"}';
    }
    # Add the owner's independently configured static reader location here.
}
