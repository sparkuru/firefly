COMMENTS_BIND=127.0.0.1
COMMENTS_PORT=8787
COMMENTS_DATABASE_PATH=/var/lib/firefly-comments/core.db
COMMENTS_SECRETS_FILE=/run/secrets/comments.env
# The default container candidate is /app/config/site.toml; override only when needed.
# COMMENTS_CONFIG_PATH=/app/config/site.toml
COMMENTS_POST_ROUTES=/posts/ai/llm-workflow-with-trellis/
COMMENTS_ALLOWED_ORIGINS=https://comments-staging.invalid
COMMENTS_EMAIL_KEY=<inject-a-32-byte-runtime-key>
COMMENTS_TOKEN_SECRET=<inject-a-runtime-secret>
COMMENTS_CONTROL_SECRET=<inject-a-runtime-secret>
COMMENTS_ABUSE_SECRET=<inject-a-runtime-secret>
COMMENTS_ADMIN_TOKEN=<inject-a-runtime-admin-token>
# Non-secret comments SMTP, public-origin, consent, and outbox settings are
# read from the repository-level config/site.toml [comments] namespace.
# These environment variables remain supported as explicit overrides.
# COMMENTS_SMTP_HOST=smtp.example.invalid
# COMMENTS_SMTP_PORT=587
# COMMENTS_SMTP_SECURE=false
# COMMENTS_SMTP_USER=comments@example.invalid
COMMENTS_SMTP_PASSWORD=<inject-an-app-specific-password>
# COMMENTS_SMTP_FROM=comments@example.invalid
# COMMENTS_SMTP_FROM_NAME=Firefly comments
# COMMENTS_PUBLIC_ORIGIN=https://comments-staging.invalid
# COMMENTS_OUTBOX_PATH=/var/lib/firefly-comments/notifications.jsonl
# COMMENTS_OUTBOX_STATE_PATH=/var/lib/firefly-comments/notifications.jsonl.state.json
# COMMENTS_CONSENT_VERSION=m51-v1
