COMMENTS_BIND=127.0.0.1
COMMENTS_PORT=8787
COMMENTS_CONFIG_PATH=/app/config/plugins/comments/config.toml
COMMENTS_SECRETS_FILE=/run/secrets/comments.env

# Keep non-secret post routes, origins, SMTP settings, named secret
# references, database, and outbox paths in the plugin config TOML. Keep only
# runtime secret values in config/plugins/comments/secrets.env.
