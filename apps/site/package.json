{
  "name": "@f1refly/site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare:content": "node scripts/materialize-content.mjs",
    "dev": "npm run prepare:content && astro dev",
    "start": "npm run prepare:content && astro dev",
    "start:e2e": "astro preview",
    "check": "npm run prepare:content && astro check",
    "build": "npm run prepare:content && astro check && astro build && node --test tests/static-output.test.mjs",
    "build:workspace": "npm run prepare:content && astro check && astro build",
    "test:content": "node --test --test-concurrency=1 tests/content-access.test.mjs tests/content-materializer.test.mjs tests/content-schema.test.mjs tests/content-build-negatives.test.mjs tests/site-config.test.mjs",
    "test:x-core": "node --test tests/x-core-integration.test.mjs",
    "test:e2e": "playwright test",
    "review:m5": "playwright test --config playwright.review.config.ts",
    "preview": "astro preview",
    "astro": "npm run prepare:content && astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@f1refly/presentation-semantic": "file:../../presentations/semantic",
    "@f1refly/presentation-terminal": "file:../../presentations/terminal",
    "@f1refly/validate-experiments": "file:../../tooling/validate-experiments",
    "@f1refly/x-core": "file:../../packages/x-core",
    "astro": "7.1.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
