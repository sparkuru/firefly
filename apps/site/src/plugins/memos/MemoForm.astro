---
import type { MemosPublicConfig } from '../../../../../plugins/memos/config.mjs';
import { MAX_BODY_BYTES, MAX_DISPLAY_NAME_CODE_POINTS } from '../../../../../plugins/memos/public.mjs';
interface Props { config: MemosPublicConfig }
const { config } = Astro.props;
if (config.writeOrigin === null) throw new TypeError('An enabled memo form requires an HTTPS write origin.');
const action = new URL('/v1/memos/submissions', config.writeOrigin).href;
---
<section class="memo-submission" aria-labelledby="memo-form-heading">
  <h2 id="memo-form-heading">Leave a memo</h2>
  <p id="memo-process">Your email stays private. Verify your email using the link we send you; your note then waits for owner review. Approved notes appear after a later static site release.</p>
  <form action={action} method="post" enctype="application/x-www-form-urlencoded" aria-describedby="memo-process">
    <label for="memo-name">Display name</label>
    <input id="memo-name" name="displayName" type="text" required autocomplete="nickname" aria-describedby="memo-name-limit" />
    <p id="memo-name-limit">Up to {MAX_DISPLAY_NAME_CODE_POINTS} Unicode code points.</p>
    <label for="memo-email">Private verification email</label>
    <input id="memo-email" name="email" type="email" required maxlength="320" autocomplete="email" />
    <label for="memo-body">Your note (plain text)</label>
    <textarea id="memo-body" name="body" required rows="6" aria-describedby="memo-body-limit"></textarea>
    <p id="memo-body-limit">Up to {MAX_BODY_BYTES} UTF-8 bytes. The server checks these limits.</p>
    <input type="hidden" name="consentVersion" value={config.consentVersion} />
    <input type="hidden" name="honeypot" value="" autocomplete="off" />
    <label class="memo-consent" for="memo-consent">
      <input id="memo-consent" name="consent" type="checkbox" value="accepted" required />
      <span>I agree to publish my display name and note after verification and owner approval.</span>
    </label>
    <button type="submit">Send verification email</button>
  </form>
</section>
<style>
  .memo-submission { margin-block: 2rem; }
  form { display: grid; gap: 0.75rem; min-width: 0; }
  input:not([type='checkbox']), textarea { width: 100%; min-width: 0; box-sizing: border-box; padding: 0.75rem; border: 1px solid #777; border-radius: 0.25rem; font: inherit; background: var(--surface, white); color: inherit; }
  textarea { resize: vertical; }
  form p { margin: 0 0 0.75rem; font-size: 0.875rem; }
  .memo-consent { display: flex; align-items: flex-start; gap: 0.75rem; }
  .memo-consent input { flex: none; margin-top: 0.3rem; }
  button { justify-self: start; padding: 0.75rem 1rem; border: 1px solid var(--text); border-radius: 0.25rem; background: var(--text); color: var(--surface); font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { background: var(--link-active); }
  :is(input, textarea, button):focus-visible { outline: 3px solid #176d83; outline-offset: 3px; }
</style>
