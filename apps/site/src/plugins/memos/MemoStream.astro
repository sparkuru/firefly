---
import type { PublicMemo } from '../../../../../plugins/memos/public.mjs';
interface Props { memos: readonly PublicMemo[] }
const { memos } = Astro.props;
---
<section aria-labelledby="memo-stream-heading" class="memo-stream">
  <h2 id="memo-stream-heading">Reader notes</h2>
  {memos.length === 0 ? <p>No published memos yet. You can leave a note below.</p> : (
    <ol class="memo-list">
      {memos.map((memo) => (
        <li>
          <article>
            <h3>{memo.displayName}</h3>
            <time datetime={memo.createdAt}>{memo.createdAt}</time>
            <p class="memo-body">{memo.body}</p>
          </article>
        </li>
      ))}
    </ol>
  )}
</section>
<style>
  .memo-stream { margin-block: 2rem; min-width: 0; }
  .memo-list { list-style: none; padding: 0; }
  .memo-list li { border-block-start: 1px solid var(--color-border, #ddd); padding-block: 1.25rem; }
  h3, time, .memo-body { overflow-wrap: anywhere; }
  h3 { margin-block: 0 0.5rem; }
  time { font-size: 0.875rem; }
  .memo-body { white-space: pre-wrap; }
</style>
