---
import type { CollectionEntry } from 'astro:content';
import DocumentPresentation from '../../components/DocumentPresentation.astro';
import { getPublicPages } from '../../lib/content';
import { renderDocument } from '../../lib/render-document';

export async function getStaticPaths() {
  const pages = await getPublicPages();

  return pages.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const document = await renderDocument(entry);
---

<DocumentPresentation entry={entry} document={document} />
