---
import {
  decodeTerminalEntries,
  decodeTerminalExperiments,
  formatResourcePath
} from '@firefly/presentation-terminal/runtime';
import TerminalHome from '../components/TerminalHome.astro';
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { getCanonicalContent } from '../lib/content';
import { getPublicExperiments } from '../lib/experiments';
import { renderDocument } from '../lib/render-document';
import {
  serializeDocumentNavigationCapabilityLookup
} from '../lib/document-navigation.ts';
import { createDocumentNavigationLookup } from '../lib/document-navigation-composition.ts';
import { SITE_CONFIG } from '../lib/site-config.mjs';

const { documents: canonicalDocuments, directories } = await getCanonicalContent();
const publicExperiments = await getPublicExperiments();
const entries = decodeTerminalEntries(canonicalDocuments.map((canonical) => ({
  kind: canonical.collection === 'posts' ? 'post' : 'page',
  virtualPath: canonical.virtualPath,
  relativePath: canonical.relativePath,
  filename: canonical.filename,
  title: canonical.displayName,
  href: canonical.href,
  date: canonical.entry.data.date.toISOString().slice(0, 10)
})));
const experiments = decodeTerminalExperiments(
  publicExperiments.map((experiment) => ({
    id: experiment.id,
    title: experiment.title,
    href: experiment.href
  }))
);
const documentNavigationLookup = serializeDocumentNavigationCapabilityLookup(
  createDocumentNavigationLookup(canonicalDocuments, SITE_CONFIG)
);
const documents = await Promise.all(
  canonicalDocuments.map(async (canonical, index) => {
    const terminalEntry = entries[index];
    if (terminalEntry === undefined) {
      throw new Error(`Missing Terminal index entry for ${canonical.virtualPath}.`);
    }
    return {
      canonical,
      entry: canonical.entry,
      terminalEntry,
      document: await renderDocument(canonical.entry)
    };
  })
);
---

<TerminalLayout
  title={SITE_CONFIG.site.name}
  description={SITE_CONFIG.site.description}
  pathname="/"
  path={formatResourcePath('/posts')}
  home
>
  <TerminalHome documents={documents} experiments={experiments} browseDirectories={directories.filter((directory) => directory.virtualPath === 'pages' || directory.virtualPath === 'posts' || directory.virtualPath.startsWith('posts/'))} browseExperiments={publicExperiments.map((experiment) => ({ id: experiment.id, title: experiment.title, href: experiment.entryHref }))} documentNavigationLookup={documentNavigationLookup} />
</TerminalLayout>
