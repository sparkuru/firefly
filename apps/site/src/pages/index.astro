---
import {
  decodeTerminalEntries,
  decodeTerminalExperiments
} from '@f1refly/presentation-terminal/runtime';
import TerminalHome from '../components/TerminalHome.astro';
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { getCanonicalContent } from '../lib/content';
import { getPublicExperiments } from '../lib/experiments';
import { renderDocument } from '../lib/render-document';

const { documents: canonicalDocuments } = await getCanonicalContent();
const publicExperiments = await getPublicExperiments();
const entries = decodeTerminalEntries(canonicalDocuments.map((canonical) => ({
  kind: canonical.collection === 'posts' ? 'post' : 'page',
  virtualPath: canonical.virtualPath,
  relativePath: canonical.relativePath,
  filename: canonical.filename,
  title: canonical.entry.data.title,
  href: canonical.href,
  date: canonical.entry.data.date.toISOString().slice(0, 10)
})));
const experiments = decodeTerminalExperiments(
  publicExperiments.map((experiment) => ({
    id: experiment.id,
    title: experiment.title,
    href: experiment.href
  }))
);
const documents = await Promise.all(
  canonicalDocuments.map(async (canonical, index) => {
    const terminalEntry = entries[index];
    if (terminalEntry === undefined) {
      throw new Error(`Missing Terminal index entry for ${canonical.virtualPath}.`);
    }
    return {
      entry: canonical.entry,
      terminalEntry,
      document: await renderDocument(canonical.entry)
    };
  })
);
---

<TerminalLayout
  title="f1refly"
  description="A static garden for notes, experiments, and durable web writing."
  path="~/blog/posts"
  home
>
  <TerminalHome documents={documents} experiments={experiments} />
</TerminalLayout>
