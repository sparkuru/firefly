---
import { render, type CollectionEntry } from 'astro:content';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { getPublicPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublicPosts();

  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocumentLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="article-header">
      <p class="eyebrow">Post</p>
      <h1>{entry.data.title}</h1>
      <p class="content-meta">
        <time datetime={entry.data.date.toISOString()}>
          {
            entry.data.date.toLocaleDateString('en', {
              dateStyle: 'long',
              timeZone: 'UTC'
            })
          }
        </time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</DocumentLayout>
