---
import type { CollectionEntry } from 'astro:content';
import SemanticDocument from '../../components/SemanticDocument.astro';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { getPublicPosts } from '../../lib/content';
import { renderDocument } from '../../lib/render-document';

export async function getStaticPaths() {
  const posts = await getPublicPosts();

  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const document = await renderDocument(entry);
---

<DocumentLayout title={entry.data.title} description={entry.data.description}>
  <SemanticDocument entry={entry} document={document} />
</DocumentLayout>
