---
import DocumentPresentation from '../../components/DocumentPresentation.astro';
import ContentDirectoryIndex from '../../components/ContentDirectoryIndex.astro';
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { getCanonicalContent, type CanonicalDocument, type ContentDirectory } from '../../lib/content';
import { SITE_CONFIG } from '../../lib/site-config.mjs';
import { renderDocument } from '../../lib/render-document';
import { loadPostPluginData, postPluginExtensions } from '../../lib/site-plugins';

type RouteProps =
  | { kind: 'document'; canonical: CanonicalDocument; pluginExtensions: readonly unknown[] }
  | { kind: 'directory'; directory: ContentDirectory };

export async function getStaticPaths() {
  const content = await getCanonicalContent();
  const postPluginData = await loadPostPluginData(content.posts, SITE_CONFIG);
  return [
    ...content.posts.map((canonical) => ({
      params: { path: canonical.href.slice('/posts/'.length, -1) },
      props: { kind: 'document' as const, canonical, pluginExtensions: postPluginExtensions(canonical, SITE_CONFIG, postPluginData) }
    })),
    ...content.directories
      .filter(({ virtualPath }) => virtualPath.startsWith('posts/') )
      .map((directory) => ({ params: { path: directory.virtualPath.slice('posts/'.length) }, props: { kind: 'directory' as const, directory } }))
  ];
}

const props = Astro.props as RouteProps;
const rendered = props.kind === 'document' ? await renderDocument(props.canonical.entry) : null;
---

{props.kind === 'document' && rendered ? (
  <DocumentPresentation canonical={props.canonical} document={rendered} pluginExtensions={props.pluginExtensions} />
) : props.kind === 'directory' ? (
  <TerminalLayout title={props.directory.name} description={`Public directory ${props.directory.virtualPath}.`} path={`~/blog/${props.directory.virtualPath}`}>
    <ContentDirectoryIndex directory={props.directory} />
  </TerminalLayout>
) : null}
