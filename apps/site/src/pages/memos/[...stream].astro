---
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import MemoStream from '../../plugins/memos/MemoStream.astro';
import MemoForm from '../../plugins/memos/MemoForm.astro';
import { SITE_CONFIG } from '../../lib/site-config.mjs';
import { loadMemoStream, MEMOS_SITE_PLUGIN } from '../../lib/site-plugins';
import type { MemoStreamBuildData } from '../../plugins/memos/index.mjs';

export function getStaticPaths() {
  const stream = loadMemoStream(SITE_CONFIG);
  return stream === null ? [] : [{ params: { stream: undefined }, props: { stream } }];
}

interface Props { stream: MemoStreamBuildData }
const { stream } = Astro.props;
---
<DocumentLayout title="Memos" description="Short notes shared by readers, verified and approved before publication." pathname={MEMOS_SITE_PLUGIN.route}>
  <h1>Memos</h1>
  <p>Short notes shared by readers and approved by the owner.</p>
  <MemoStream memos={stream.envelope.memos} />
  <MemoForm config={stream.public} />
</DocumentLayout>
