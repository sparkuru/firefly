---
import type { DocumentNavigatorProfile } from '../lib/document-navigation.ts';
import { navigationInitialState } from '../lib/document-navigation.ts';
import type { DocumentNavigatorAssets } from '../lib/presentation-experiences.ts';
import type { DocumentNavigatorExitPolicy } from '../lib/presentation-experiences.ts';
import semanticNavigationCss from '../styles/document-navigation-semantic.css?raw';
import terminalNavigationCss from '../styles/document-navigation-terminal.css?raw';

interface Props {
  variant: 'semantic' | 'terminal';
  profile: DocumentNavigatorProfile;
  exitPolicy: DocumentNavigatorExitPolicy;
  assets: DocumentNavigatorAssets;
}

const { variant, profile, exitPolicy, assets } = Astro.props;
const navigationCss = variant === 'terminal' ? terminalNavigationCss : semanticNavigationCss;
const expectedStyles = variant === 'terminal' ? assets.terminalStyles : assets.semanticStyles;
if (assets.runtime !== 'document-navigator' || expectedStyles !== `document-navigation-${variant}`) {
  throw new Error(`Unsupported document navigator assets for ${variant} presentation.`);
}
const className = variant === 'terminal' ? 'terminal-navigation-status' : 'document-navigation-status';
const { statusHidden: initiallyHidden } = navigationInitialState(profile);
---

<style is:inline set:html={navigationCss}></style>

<section
  class={className}
  data-document-navigator-status
  aria-label="Document navigation status"
  hidden={initiallyHidden}
>
  <p>
    <span data-navigation-mode>-- NORMAL --</span>
    <span data-navigation-position>1/1</span>
    {exitPolicy === 'local' && (
      <button type="button" data-navigation-exit-control hidden>Exit navigation</button>
    )}
  </p>
  <p data-navigation-search-status hidden></p>
  <form data-navigation-search-form hidden>
    <label data-navigation-search-label for="document-navigation-search">Search document forward</label>
    <span data-navigation-search-prefix aria-hidden="true">/</span><input id="document-navigation-search" type="search" autocomplete="off" placeholder="Search forward…" />
  </form>
  <form data-navigation-command-form hidden>
    <label for="document-navigation-command">Navigation command</label>
    <span aria-hidden="true">:</span><input id="document-navigation-command" type="text" autocomplete="off" />
  </form>
  <p data-navigation-message>j/k move · /? search · v select · :q exit</p>
  <p class={variant === 'terminal' ? 'terminal-visually-hidden' : 'navigation-visually-hidden'} data-navigation-announcer aria-live="polite" aria-atomic="true"></p>
</section>

<script>
  import { startDocumentNavigator } from '../scripts/document-navigator.ts';
  const navigator = document.querySelector<HTMLElement>('[data-document-navigator]');
  if (navigator !== null) startDocumentNavigator(navigator);
</script>
