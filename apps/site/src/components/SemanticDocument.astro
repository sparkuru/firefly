---
import type { CanonicalDocument } from '../lib/content';
import type { DocumentNavigatorProfile } from '../lib/document-navigation.ts';
import { navigationInitialState } from '../lib/document-navigation.ts';
import type { renderDocument } from '../lib/render-document';
import type { CommentsSiteConfig, PublicComment } from '../lib/comments';
import CommentSection from '../plugins/comments/CommentSection.astro';
import ContentMarkers from './ContentMarkers.astro';
import DocumentNavigationStatus from './DocumentNavigationStatus.astro';

type RenderedDocument = Awaited<ReturnType<typeof renderDocument>>;

interface Props {
  navigatorProfile: DocumentNavigatorProfile;
  articleTheme: string;
  canonical: CanonicalDocument;
  document: RenderedDocument;
  comments: readonly PublicComment[];
  commentsPostPath: string | null;
  commentsConfig: CommentsSiteConfig;
  commentsEnabled: boolean;
}

const { navigatorProfile, articleTheme, canonical, document, comments, commentsPostPath, commentsConfig, commentsEnabled } = Astro.props;
const { entry } = canonical;
const { Content, metadata } = document;
const { regionTabIndex } = navigationInitialState(navigatorProfile);
const showOutline = metadata.outline.length >= 2;
const kind = entry.collection === 'posts' ? 'Post' : 'Page';
---

<article class="semantic-document" data-document-navigator data-document-navigator-entry={navigatorProfile.entry}>
  <header class="article-header">
    <p class="eyebrow">{kind}</p>
    <ContentMarkers markers={canonical.markers} />
    <h1>{entry.data.title}</h1>
    {
      entry.collection === 'posts' && (
        <p class="content-meta">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('en', {
              dateStyle: 'long',
              timeZone: 'UTC'
            })}
          </time>
        </p>
      )
    }
  </header>

  {
    showOutline && (
      <nav class="document-outline" aria-labelledby="document-outline-title">
        <p id="document-outline-title" class="document-outline-title">
          On this page
        </p>
        <ol>
          {metadata.outline.map((item) => (
            <li data-depth={item.depth}>
              <a href={`#${item.id}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <div
    id="terminal-reader"
    class="prose"
    data-article-content
    data-article-theme={articleTheme}
    data-document-navigator-region
    tabindex={regionTabIndex}
    role="region"
    aria-label={`Document navigator for ${entry.data.title}`}
  >
    <Content />
  </div>

  {entry.collection === 'posts' && commentsEnabled && commentsPostPath && (
    <CommentSection variant="semantic" postPath={commentsPostPath} comments={comments} config={commentsConfig} />
  )}

  <DocumentNavigationStatus profile={navigatorProfile} variant="semantic" />
</article>
