---
import type { CanonicalDocument } from '../lib/content';
import { navigationInitialState } from '../lib/document-navigation.ts';
import type { DocumentNavigationComposition } from '../lib/document-navigation-composition.ts';
import type { CommentsSiteConfig, PublicComment } from '../lib/comments';
import type { renderDocument } from '../lib/render-document';
import CommentSection from '../plugins/comments/CommentSection.astro';
import ContentMarkers from './ContentMarkers.astro';
import DocumentNavigationStatus from './DocumentNavigationStatus.astro';
import { getPostLicense } from '../lib/post-license.mjs';
import { resolveDocumentShareUrl } from '../lib/document-share-url.mjs';

type RenderedDocument = Awaited<ReturnType<typeof renderDocument>>;

interface Props {
  documentNavigation: DocumentNavigationComposition;
  contentTheme: string;
  canonical: CanonicalDocument;
  document: RenderedDocument;
  comments: readonly PublicComment[];
  commentsPostPath: string | null;
  commentsConfig: CommentsSiteConfig;
  commentsEnabled: boolean;
}

const { documentNavigation, contentTheme, canonical, document, comments, commentsPostPath, commentsConfig, commentsEnabled } = Astro.props;
const { entry } = canonical;
const { Content, metadata } = document;
const enabled = documentNavigation.kind === 'document-navigator';
const navigationState = enabled ? navigationInitialState(documentNavigation.profile) : null;
const navigatorProfile = enabled ? documentNavigation.profile : null;
const showOutline = metadata.outline.length >= 2;
const outlineRootDepth = metadata.outline[0]?.depth ?? 0;
const license = entry.collection === 'posts' ? getPostLicense(entry.data.license) : undefined;
const shareUrl = resolveDocumentShareUrl(canonical.href, entry.data.canonical);
const date = entry.data.date.toISOString().slice(0, 10);

function hasLaterSibling(index: number, depth: number) {
  for (const item of metadata.outline.slice(index + 1)) {
    if (item.depth < depth) return false;
    if (item.depth === depth) return true;
  }
  return false;
}

function outlinePrefix(index: number, depth: number) {
  const visibleDepth = Math.max(0, depth - outlineRootDepth);
  const ancestors = Array.from({ length: visibleDepth }, (_, level) =>
    hasLaterSibling(index, outlineRootDepth + level) ? '│   ' : '    '
  ).join('');
  const branch = hasLaterSibling(index, depth) ? '├── ' : '└── ';
  return `${ancestors}${branch}`;
}
---

<article
  class="terminal-document"
  data-document-sharing
  data-document-navigator={enabled ? '' : undefined}
  data-document-navigator-entry={navigatorProfile?.entry}
  data-document-navigator-supports-mobile={enabled ? String(navigatorProfile?.supportsMobile) : undefined}
  data-document-navigator-exit={enabled ? documentNavigation.exitPolicy : undefined}
>
  <header class="terminal-document-header">
    <ContentMarkers markers={canonical.markers} />
    <h1>{entry.data.title}</h1>
    <p class="terminal-meta" data-document-file-metadata>
      <time datetime={entry.data.date.toISOString()}>{date}</time>
      <span aria-hidden="true"> · </span>
      <span data-terminal-source-bytes={document.sourceByteLength} data-terminal-source-kind={document.sourceKind}>{document.sourceByteLength} bytes</span>
      {license && <><span aria-hidden="true"> · </span><a href={license.href} data-terminal-license={entry.data.license}>{license.label}</a></>}
      <span class="terminal-document-share-group" hidden data-document-share-group>
        <span aria-hidden="true"> · </span><button type="button" class="terminal-document-share" data-document-share data-document-share-url={shareUrl} hidden>Share</button>
      </span>
      <span class="terminal-visually-hidden" data-document-share-announcer aria-live="polite" aria-atomic="true"></span>
    </p>
  </header>

  {
    showOutline && (
      <nav class="terminal-outline" aria-label="Document outline">
        <ul>
          {metadata.outline.map((item, index) => (
            <li data-depth={item.depth}>
              <span class="terminal-outline-prefix" aria-hidden="true">{outlinePrefix(index, item.depth)}</span>
              <a href={`#${item.id}`}>{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div
    id={enabled ? 'document-navigator' : undefined}
    class="terminal-prose"
    data-article-content
    data-content-theme={contentTheme}
    data-document-navigator-region={enabled ? '' : undefined}
    tabindex={navigationState?.regionTabIndex}
    role={enabled ? 'region' : undefined}
    aria-label={enabled ? `Document navigator for ${entry.data.title}` : undefined}
  ><Content /></div>

  {entry.collection === 'posts' && commentsEnabled && commentsPostPath && (
    <CommentSection variant="terminal" postPath={commentsPostPath} comments={comments} config={commentsConfig} />
  )}

  {enabled && navigatorProfile && (
    <DocumentNavigationStatus profile={navigatorProfile} variant="terminal" exitPolicy={documentNavigation.exitPolicy} assets={documentNavigation.assets} />
  )}
</article>

<script>
  import { startDocumentShare } from '../scripts/document-share';
  const root = document.querySelector<HTMLElement>('[data-document-sharing]');
  if (root !== null) startDocumentShare(root);
</script>
