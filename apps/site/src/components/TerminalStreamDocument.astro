---
import { formatResourcePath, type TerminalEntry } from '@firefly/presentation-terminal/runtime';
import type { PublicDocument, renderDocument } from '../lib/render-document';
import { getPostLicense } from '../lib/post-license.mjs';
import { resolveDocumentShareUrl } from '../lib/document-share-url.mjs';

type RenderedDocument = Awaited<ReturnType<typeof renderDocument>>;

interface Props {
  entry: PublicDocument;
  terminalEntry: TerminalEntry;
  document: RenderedDocument;
}

const { entry, terminalEntry, document } = Astro.props;
const { Content } = document;
const titleId = `terminal-stream-${terminalEntry.virtualPath.replaceAll('/', '-')}-title`;
const kind = entry.collection === 'posts' ? 'post' : 'page';
const bodyId = `${titleId}-body`;
const normalizeTitle = (value: string) => value.toLocaleLowerCase('en-US').replace(/[\s_-]+/gu, ' ').trim();
const firstHeading = document.metadata.outline[0];
const startsWithHeading = /^\s*(?:<!--[\s\S]*?-->\s*)*<h[2-6]\b/u.test(entry.rendered?.html ?? '');
const repeatedTitle = startsWithHeading && firstHeading !== undefined &&
  normalizeTitle(firstHeading.text) === normalizeTitle(entry.data.title ?? terminalEntry.title);
const shareUrl = resolveDocumentShareUrl(terminalEntry.href, entry.data.canonical);
const license = entry.collection === 'posts' ? getPostLicense(entry.data.license) : undefined;
---

<article
  class="terminal-stream-document"
  data-terminal-stream-document
  data-terminal-repeated-title={repeatedTitle ? '' : undefined}
  aria-labelledby={titleId}
>
  {
    repeatedTitle && (
      <span id={titleId} class="terminal-visually-hidden" data-terminal-stream-title data-terminal-stream-title-placeholder>
        {entry.data.title}
      </span>
    )
  }
  <p class="terminal-stream-meta terminal-visually-hidden" aria-hidden="true">
      {kind}
      <span aria-hidden="true"> · </span>
      <time datetime={entry.data.date.toISOString()}>{terminalEntry.date}</time>
  </p>
  <nav class="terminal-stream-actions" aria-label="Article reading actions">
      <button type="button" data-terminal-return>Command</button>
      <span aria-hidden="true" class="terminal-stream-action-separator">|</span>
      <button type="button" data-terminal-collapse aria-expanded="true" aria-controls={bodyId}>Collapse</button>
      <span aria-hidden="true" class="terminal-stream-action-separator">|</span>
      <a href={terminalEntry.href} data-terminal-open aria-label="Open document" target="_blank" rel="noopener">Open</a>
      <span aria-hidden="true" class="terminal-stream-action-separator">|</span>
      <button type="button" data-terminal-share data-terminal-share-url={shareUrl}>Share</button>
  </nav>
  {
    !repeatedTitle && (
      <header class="terminal-stream-header">
        <h2 id={titleId} data-terminal-stream-title tabindex="-1">
          {entry.data.title}
        </h2>
      </header>
    )
  }
  <div id={bodyId} class="terminal-stream-prose"><Content /></div>
  <footer class="terminal-stream-footer">
    <span>{formatResourcePath(`/${terminalEntry.virtualPath}`)}</span>
    <span aria-hidden="true"> · </span>
    <time datetime={entry.data.date.toISOString()}>{terminalEntry.date}</time>
    <span aria-hidden="true"> · </span>
    <span data-terminal-source-bytes={document.sourceByteLength} data-terminal-source-kind={document.sourceKind}>{document.sourceByteLength} bytes</span>
    {license && <><span aria-hidden="true"> · </span><a href={license.href} data-terminal-license={entry.data.license}>{license.label}</a></>}
  </footer>
</article>
