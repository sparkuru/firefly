---
import {
  formatDocumentOperand,
  formatTerminalPrompt,
  type TerminalEntry,
  type TerminalExperiment
} from '@firefly/presentation-terminal/runtime';
import type { PublicDocument, renderDocument } from '../lib/render-document';
import type { CanonicalDocument } from '../lib/content';
import { SITE_CONFIG, terminalIdentityFromConfig } from '../lib/site-config.mjs';
import { MOBILE_DOCUMENT_NAVIGATION_QUERY } from '../lib/document-navigation';
import ContentMarkers from './ContentMarkers.astro';
import TerminalStreamDocument from './TerminalStreamDocument.astro';

type RenderedDocument = Awaited<ReturnType<typeof renderDocument>>;

interface HomeDocument {
  canonical: CanonicalDocument;
  entry: PublicDocument;
  terminalEntry: TerminalEntry;
  document: RenderedDocument;
}

interface Props {
  documents: readonly HomeDocument[];
  experiments: readonly TerminalExperiment[];
  documentNavigationLookup: string;
}

interface FriendLink {
  readonly name: string;
  readonly desc?: string;
  readonly url: string;
}

const { documents, experiments, documentNavigationLookup } = Astro.props;
const identity = terminalIdentityFromConfig();
const prompt = formatTerminalPrompt(identity, { cwd: identity.workingDirectory });
const encodedAbout = encodeURIComponent(identity.about);
const posts = documents.filter(({ terminalEntry }) => terminalEntry.kind === 'post');
const pages = documents.filter(({ terminalEntry }) => terminalEntry.kind === 'page');
const friendLinks = SITE_CONFIG.terminal.friends as readonly FriendLink[];
const TERMINAL_HOME_STARTUP_LOG_LINES = [
  '[  OK  ] loading public document index',
  '[  OK  ] checking native recovery links',
  '[  OK  ] mounting public posts',
  '[  OK  ] mounting public pages',
  '[  OK  ] validating document templates',
  '[  OK  ] preparing terminal session',
  '[  OK  ] initializing shell',
  '[ WARN ] I dreamed of a scorched earth.',
  '[ WARN ] A new shoot broke through the soil, blooming toward the rising sun, whispering softly to me.',
  '[ WARN ] I will live for myself, and I will die as \'Firefly\'.',
  '[  OK  ] awaiting command prompt ...',
  '[  OK  ] 「FLY ME TO THE STAR」'
] as const;
const TERMINAL_HOME_STARTUP_LINE_DELAY_MS = 100;
const TERMINAL_HOME_STARTUP_LINE_DURATION_MS = 180;
const TERMINAL_HOME_STARTUP_PROMPT_GAP_MS = 120;
const TERMINAL_HOME_STARTUP_PROMPT_DELAY_MS =
  (TERMINAL_HOME_STARTUP_LOG_LINES.length - 1) * TERMINAL_HOME_STARTUP_LINE_DELAY_MS +
  TERMINAL_HOME_STARTUP_LINE_DURATION_MS +
  TERMINAL_HOME_STARTUP_PROMPT_GAP_MS;
const TERMINAL_HOME_STARTUP_DURATION_MS =
  TERMINAL_HOME_STARTUP_PROMPT_DELAY_MS + TERMINAL_HOME_STARTUP_LINE_DURATION_MS;
---

<section
  class="terminal-home"
  data-terminal-home
  data-terminal-identity-user={identity.user}
  data-terminal-identity-host={identity.host}
  data-terminal-identity-cwd={identity.workingDirectory}
  data-terminal-identity-about={encodedAbout}
  data-terminal-identity-prompt-marker={identity.promptMarker}
  data-terminal-document-navigation={documentNavigationLookup}
  data-terminal-boot-duration={TERMINAL_HOME_STARTUP_DURATION_MS}
  data-terminal-mobile-query={MOBILE_DOCUMENT_NAVIGATION_QUERY}
>
  <script is:inline data-terminal-startup-marker>
    (() => {
      const root = document.querySelector('[data-terminal-home]');
      if (!(root instanceof HTMLElement)) {
        return;
      }

      const mobile = window.matchMedia(root.dataset.terminalMobileQuery);
      if (mobile.matches) return;
      root.dataset.terminalStartupState = 'connecting';
      let startupObserver;
      const releaseStartupGuards = () => {
        document.removeEventListener('keydown', guardEscape, true);
        document.removeEventListener('keydown', guardCtrlL, true);
        startupObserver?.disconnect();
      };
      const guardEscape = (event) => {
        if (root.dataset.terminalStartupState !== 'connecting') {
          releaseStartupGuards();
          return;
        }
        if (mobile.matches) return;
        if (event.target instanceof Element && event.target.closest('[data-home-search]') !== null) {
          return;
        }
        if (
          !event.defaultPrevented &&
          event.key === 'Escape' &&
          !event.altKey &&
          !event.ctrlKey &&
          !event.metaKey &&
          !event.shiftKey &&
          !event.isComposing
        ) {
          event.preventDefault();
        }
      };
      const guardCtrlL = (event) => {
        if (root.dataset.terminalStartupState !== 'connecting') {
          releaseStartupGuards();
          return;
        }
        if (mobile.matches) return;
        const target = event.target;
        const startupSurface = target instanceof Element &&
          target.closest('[data-terminal-startup]') !== null;
        const pageSurface = target === document.body || target === document.documentElement;
        const selection = window.getSelection();
        if (
          event.defaultPrevented ||
          !event.cancelable ||
          event.isComposing ||
          event.key.toLocaleLowerCase('en-US') !== 'l' ||
          !event.ctrlKey ||
          event.altKey ||
          event.metaKey ||
          event.shiftKey ||
          (!startupSurface && !pageSurface) ||
          (selection !== null && !selection.isCollapsed)
        ) {
          return;
        }
        event.preventDefault();
        root.dataset.terminalPendingClear = '';
      };
      document.addEventListener('keydown', guardEscape, true);
      document.addEventListener('keydown', guardCtrlL, true);
      startupObserver = new MutationObserver(() => {
        if (root.dataset.terminalStartupState !== 'connecting') {
          releaseStartupGuards();
        }
      });
      startupObserver.observe(root, {
        attributes: true,
        attributeFilter: ['data-terminal-startup-state']
      });
      const markUnstartedAsFailed = () => {
        if (
          root.dataset.terminalStartupState === 'connecting' &&
          !root.hasAttribute('data-terminal-controller-initialized')
        ) {
          root.dataset.terminalStartupState = 'failed';
        }
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', markUnstartedAsFailed, { once: true });
      } else {
        markUnstartedAsFailed();
      }
    })();
  </script>
  <h1 class="terminal-visually-hidden">{SITE_CONFIG.site.name} articles</h1>

  <section class="home-search" data-home-search aria-label="全站文章搜索" hidden>
    <form role="search">
      <label for="home-search-query">搜索文章</label>
      <p id="home-search-help" class="home-search-help">查找标题、标签或正文中的内容</p>
      <div class="home-search-controls">
        <input id="home-search-query" type="search" autocomplete="off" enterkeyhint="search"
          autocapitalize="off" spellcheck="false" placeholder="输入关键词…"
          aria-describedby="home-search-help" aria-controls="home-search-results" />
        <button type="submit">搜索</button>
        <button type="button" data-home-search-clear disabled>清空</button>
      </div>
    </form>
    <p data-home-search-status role="status" aria-live="polite" aria-atomic="true"></p>
    <ul id="home-search-results" class="home-search-results" data-home-search-results hidden></ul>
  </section>
  <p class="home-search-error" data-home-search-error role="status" hidden>
    文章搜索暂时不可用，请使用下方文章列表浏览。
  </p>

  <section
    class="terminal-startup"
    data-terminal-startup
    aria-labelledby="terminal-startup-heading"
  >
    <div class="terminal-boot-surface" data-terminal-boot-log>
      <h2 id="terminal-startup-heading" class="terminal-visually-hidden">
        Starting {SITE_CONFIG.site.name} articles
      </h2>
      <div class="terminal-boot-lines" aria-hidden="true">
        {TERMINAL_HOME_STARTUP_LOG_LINES.map((line, index) => (
          <p
            class="terminal-boot-line"
            style={`--terminal-boot-delay: ${index * TERMINAL_HOME_STARTUP_LINE_DELAY_MS}ms;`}
          >{line}</p>
        ))}
      </div>
      <div
        class="terminal-command-row terminal-boot-prompt"
        data-terminal-boot-prompt
        style={`--terminal-boot-prompt-delay: ${TERMINAL_HOME_STARTUP_PROMPT_DELAY_MS}ms;`}
        aria-hidden="true"
      >
        <span class="terminal-prompt">{prompt}</span>
        <span class="terminal-boot-input-space"></span>
      </div>
    </div>
  </section>

  <section
    class="terminal-recovery"
    data-terminal-fallback
    aria-labelledby="terminal-recovery-heading"
  >
    <p class="terminal-path" data-home-shell-only><span class="terminal-prompt">{prompt}</span> ls</p>
    <h2 id="terminal-recovery-heading" tabindex="-1">Browse public documents</h2>
    <p data-home-shell-only>
      The interactive shell is optional. These native links remain available
      without JavaScript and return if the shell cannot continue.
    </p>
    <p class="terminal-failure" data-home-shell-only data-terminal-failure hidden>
      <span class="terminal-status-label">Interactive error:</span>
      The command shell is unavailable. Use the document links below.
    </p>

    <nav class="terminal-index" aria-label="Public document index">
      <section class="terminal-group" aria-labelledby="terminal-posts-heading">
        <h3 id="terminal-posts-heading">posts/</h3>
        {
          posts.length === 0 ? (
            <p class="terminal-meta">No public posts.</p>
          ) : (
            <ul class="terminal-list">
              {posts.map(({ canonical, terminalEntry }) => (
                <li
                  class="terminal-entry"
                  data-terminal-entry
                  data-terminal-entry-kind={terminalEntry.kind}
                  data-terminal-entry-virtual-path={terminalEntry.virtualPath}
                  data-terminal-entry-relative-path={terminalEntry.relativePath}
                  data-terminal-entry-filename={terminalEntry.filename}
                  data-terminal-entry-title={terminalEntry.title}
                  data-terminal-entry-href={terminalEntry.href}
                  data-terminal-entry-date={terminalEntry.date}
                >
                  <a href={terminalEntry.href} aria-label={formatDocumentOperand(terminalEntry)}>{terminalEntry.title}</a>
                  <span> — {formatDocumentOperand(terminalEntry)}</span>
                  <ContentMarkers markers={canonical.markers} />
                  <time datetime={terminalEntry.date}>{terminalEntry.date}</time>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="terminal-group" aria-labelledby="terminal-pages-heading">
        <h3 id="terminal-pages-heading">pages/</h3>
        {
          pages.length === 0 ? (
            <p class="terminal-meta">No public pages.</p>
          ) : (
            <ul class="terminal-list">
              {pages.map(({ canonical, terminalEntry }) => (
                <li
                  class="terminal-entry"
                  data-terminal-entry
                  data-terminal-entry-kind={terminalEntry.kind}
                  data-terminal-entry-virtual-path={terminalEntry.virtualPath}
                  data-terminal-entry-relative-path={terminalEntry.relativePath}
                  data-terminal-entry-filename={terminalEntry.filename}
                  data-terminal-entry-title={terminalEntry.title}
                  data-terminal-entry-href={terminalEntry.href}
                  data-terminal-entry-date={terminalEntry.date}
                >
                  <a href={terminalEntry.href} aria-label={formatDocumentOperand(terminalEntry)}>{terminalEntry.title}</a>
                  <span> — {formatDocumentOperand(terminalEntry)}</span>
                  <ContentMarkers markers={canonical.markers} />
                  <time datetime={terminalEntry.date}>{terminalEntry.date}</time>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="terminal-group" aria-labelledby="terminal-lab-heading">
        <h3 id="terminal-lab-heading">lab/</h3>
        {
          experiments.length === 0 ? (
            <p class="terminal-meta">No listed experiments.</p>
          ) : (
            <ul class="terminal-list">
              {experiments.map((experiment) => (
                <li
                  class="terminal-entry"
                  data-terminal-experiment
                  data-terminal-experiment-id={experiment.id}
                  data-terminal-experiment-title={experiment.title}
                  data-terminal-experiment-href={experiment.href}
                >
                  <a href={experiment.href}>{experiment.id}/</a>
                  <span> — {experiment.title}</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="terminal-group" aria-labelledby="terminal-friends-heading">
        <h3 id="terminal-friends-heading">friend links</h3>
        {
          friendLinks.length === 0 ? (
            <p class="terminal-meta">No friend links.</p>
          ) : (
            <ul class="terminal-entry-list">
              {friendLinks.map((friend) => (
                <li
                  class="terminal-entry-row terminal-entry-row--friend"
                  data-terminal-friend
                  data-terminal-friend-name={friend.name}
                  data-terminal-friend-desc={friend.desc}
                  data-terminal-friend-url={friend.url}
                >
                  <a href={friend.url}>{friend.name}</a>
                  <span class="terminal-entry-title">{friend.desc ?? ''}</span>
                  <span class="terminal-link-url">{friend.url}</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </nav>
  </section>

  {
    documents.map(({ entry, terminalEntry, document }) => (
      <template
        data-terminal-template
        data-terminal-template-path={terminalEntry.virtualPath}
        data-home-search-metadata={JSON.stringify({
          title: terminalEntry.title,
          filename: terminalEntry.filename,
          virtualPath: terminalEntry.virtualPath,
          href: terminalEntry.href,
          date: terminalEntry.date,
          description: entry.data.description,
          tags: entry.data.tags ?? []
        })}
      >
        <TerminalStreamDocument
          entry={entry}
          terminalEntry={terminalEntry}
          document={document}
        />
      </template>
    ))
  }

  <section
    class="terminal-session"
    data-terminal-session
    aria-label="Terminal command session"
    hidden
  >
    <div id="terminal-transcript" class="terminal-transcript" data-terminal-transcript></div>
    <form class="terminal-command-form" data-terminal-form>
      <label class="terminal-visually-hidden" for="terminal-command" data-terminal-command-label>
        Command for {prompt}
      </label>
      <p id="terminal-command-help" class="terminal-visually-hidden">
        Type help for commands. Use Arrow keys for history. Control+C cancels the
        current command. Tab completes and selects command candidates. Enter or
        Space accepts an active candidate. Control+A selects the command,
        Control+E moves to its end, Control+U removes text through the cursor,
        and Escape dismisses completion candidates.
      </p>
      <div class="terminal-command-row">
        <span class="terminal-prompt" aria-hidden="true" data-terminal-prompt>{prompt}</span>
        <input
          class="terminal-command-input"
          id="terminal-command"
          name="command"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="send"
          aria-controls="terminal-transcript"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-describedby="terminal-command-help terminal-completion"
        />
      </div>
      <div
        id="terminal-completion"
        class="terminal-completion"
        data-terminal-completion
      ></div>
    </form>
    <p
      class="terminal-visually-hidden"
      data-terminal-announcer
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </section>
</section>

<script>
  import { startTerminalHome } from '../scripts/terminal-home';
  import { startHomeSearch } from '../scripts/home-search';

  const root = document.querySelector<HTMLElement>('[data-terminal-home]');
  if (root !== null) {
    startHomeSearch(root);
    startTerminalHome(root);
  }
</script>
