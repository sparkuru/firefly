---
import {
  formatResourcePath,
  formatTerminalPrompt
} from '@firefly/presentation-terminal/runtime';
import type { ContentDirectory } from '../lib/content';
import { terminalIdentityFromConfig } from '../lib/site-config.mjs';
import ContentDirectoryChildren from './ContentDirectoryChildren.astro';

interface Props {
  directory: ContentDirectory;
}

const { directory } = Astro.props;
const directoryRoot = formatResourcePath('/');
const directoryPath = formatResourcePath(`/${directory.virtualPath}`);
const directoryPrompt = formatTerminalPrompt(terminalIdentityFromConfig(), { cwd: directoryRoot });
const parentHref = directory.virtualPath.includes('/')
  ? `/${directory.virtualPath.split('/').slice(0, -1).join('/')}/`
  : '/';
---

<section class="terminal-directory">
  <nav aria-label="Directory navigation"><a href="/">{directoryRoot}</a><span aria-hidden="true"> / </span><a href={parentHref}>..</a></nav>
  <p class="terminal-prompt">{directoryPrompt} tree {directoryPath}</p>
  <h1>{directory.virtualPath}/</h1>
  <ContentDirectoryChildren directory={directory} />
</section>
