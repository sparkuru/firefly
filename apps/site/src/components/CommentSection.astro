---
import PluginCommentSection from '../plugins/comments/CommentSection.astro';
import type { CommentsSiteConfig, PublicComment } from '../lib/comments';

interface Props {
  variant: 'semantic' | 'terminal';
  postPath: string;
  comments: readonly PublicComment[];
  config: CommentsSiteConfig;
}

const { variant, postPath, comments, config } = Astro.props as Props;
const props: Props = { variant, postPath, comments, config };
---

<PluginCommentSection {...props} />
