---
import semanticStylesheetUrl from '../styles/global.css?url';
import SiteHead from '../components/SiteHead.astro';
import { SITE_CONFIG } from '../lib/site-config.mjs';

interface Props {
  title?: string;
  description: string;
  pathname?: string;
  home?: boolean;
  htmlTitle?: string;
  canonical?: string;
  seoImage?: string;
  noindex?: boolean;
  collection?: 'posts' | 'pages';
  date?: Date;
  updated?: Date;
}

const { title, description, ...headProps } = Astro.props;
---

<!doctype html>
<html lang={SITE_CONFIG.site.language}>
  <head>
    <SiteHead title={title} description={description} {...headProps} />
    <link rel="stylesheet" href={semanticStylesheetUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="site-bar">
        <a class="site-name" href="/">{SITE_CONFIG.site.name}</a>
        <nav class="site-nav" aria-label="Primary navigation">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/lab/">Lab</a></li>
            <li><a href="/pages/">Pages</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{SITE_CONFIG.site.name} — static content, rendered at build time.</p>
    </footer>
  </body>
</html>
