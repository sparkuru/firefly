---
import terminalCss from '../styles/terminal.css?raw';
import SiteHead from '../components/SiteHead.astro';
import { SITE_CONFIG } from '../lib/site-config.mjs';

interface Props {
  title?: string;
  description: string;
  path: string;
  home?: boolean;
  pathname?: string;
  htmlTitle?: string;
  canonical?: string;
  seoImage?: string;
  noindex?: boolean;
  collection?: 'posts' | 'pages';
  date?: Date;
  updated?: Date;
}

const { title, description, path, home = false, ...headProps } = Astro.props;
---

<!doctype html>
<html lang={SITE_CONFIG.site.language} class="terminal-root" data-terminal-theme="f1refly">
  <head>
    <SiteHead title={title} description={description} home={home} {...headProps} />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Regular-v2.304.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Medium-v2.304.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <style is:inline set:html={terminalCss}></style>
  </head>
  <body class:list={['terminal-body', { 'terminal-body--home': home }]}>
    <a class="terminal-skip" href="#main-content">Skip to main content</a>
    <div class:list={['terminal-shell', { 'terminal-shell--home': home }]}>
      {
        !home && (
          <div class="terminal-titlebar" aria-hidden="true">
            <span>{SITE_CONFIG.site.name} / content terminal</span>
            <span>{path}</span>
          </div>
        )
      }
      <main
        id="main-content"
        class:list={['terminal-main', { 'terminal-main--home': home }]}
        tabindex="-1"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
