# Shared preview and Docker-command configuration. Copy to the ignored .env.
# Explicit environment variables override this file, including empty values.
# Values are literal: no shell execution, escapes, or variable interpolation.
SAM_IMAGE=node:22-alpine
SAM_IPC=private
# Use 127.0.0.1 to restrict preview access to this machine.
SAM_BIND_HOST=0.0.0.0
WEB_BIND_HOST=0.0.0.0
WEB_HOST_PORT=4321
WEB_CONTAINER_PORT=4321
FIREFLY_RUNTIME_IMAGE=firefly:runtime
# Optional absolute blog root containing posts/ and pages/, plus optional memos/.
# Empty uses repo content/. Memo documents build with the coordinated site.
# FIREFLY_MEMOS_CANDIDATE is retired for active preview and runtime packaging.
FIREFLY_CONTENT_ROOT=
