# Owner-only comments runtime secrets. Copy this file to secrets.env only in
# an authorized private environment and chmod it 600 or stricter.
# The service reads it through COMMENTS_SECRETS_FILE as a read-only mount.

COMMENTS_EMAIL_KEY=<inject-a-runtime-email-key>
COMMENTS_TOKEN_SECRET=<inject-a-runtime-token-secret>
COMMENTS_CONTROL_SECRET=<inject-a-runtime-control-secret>
COMMENTS_ABUSE_SECRET=<inject-a-runtime-abuse-secret>
COMMENTS_ADMIN_TOKEN=<inject-a-runtime-admin-token>
COMMENTS_SMTP_PASSWORD=<inject-an-app-specific-password>
