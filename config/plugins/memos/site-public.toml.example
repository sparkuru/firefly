# Public-only alternative to config.toml.example for static site builds.
# Copy to the repository-relative plugins.memos.configPath before enabling.
[public]
# Required when enabled; use the site's HTTPS origin for the planned proxy.
# writeOrigin = "https://notes.example.com"
exportPath = "artifacts/memos/memos.public.v1.json"
consentVersion = "memos-v1"
