# Copy to an ignored owner-only file (0600); values are literal, without quotes
# or shell expansion. Explicit environment variables take precedence.
# Use distinct random 32-byte lowercase hex keys, retained outside backups.
MEMOS_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
MEMOS_TOKEN_KEY=replace-with-a-distinct-64-lowercase-hex-key
MEMOS_ADMIN_TOKEN=replace-with-a-random-credential-at-least-32-characters
MEMOS_SMTP_PASSWORD=replace-with-mail-provider-password
