#!/usr/bin/env bash
# sam - Run firefly development commands inside node:22-alpine.
# The host needs Docker only; the repository is mounted at /app with uid mapping.
#
# Usage:
#   ./sam npm run install:m4
#   ./sam npm run check:m4
#   ./sam npm run build:m4
#   SAM_IMAGE=mcr.microsoft.com/playwright:v1.62.0-noble SAM_IPC=host \
#     ./sam npm --prefix experiments/nerv run test:e2e
#   FIREFLY_COMMENTS_EXPORT=artifacts/comments/comments.public.v1.json \
#     ./sam npm run build:m51
#   WEB_HOST_PORT=4322 ./dev.sh
#
# Ports: the assembled publication maps container 4321 to host 4321 by default.
# Change WEB_HOST_PORT for parallel agents; WEB_CONTAINER_PORT must match the publication server port.
# Service commands must bind to 0.0.0.0 to be reachable from the host.
set -Eeuo pipefail

IMAGE="${SAM_IMAGE:-node:22-alpine}"
SAM_IPC="${SAM_IPC-private}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVHOME="${REPO_ROOT}/.devhome"
STEP_INDEX=0

SAM_BIND_HOST="${SAM_BIND_HOST:-127.0.0.1}"
WEB_HOST_PORT="${WEB_HOST_PORT:-4321}"
WEB_CONTAINER_PORT="${WEB_CONTAINER_PORT:-4321}"
COMMENTS_EXPORT_PATH="${FIREFLY_COMMENTS_EXPORT:-}"
COMMENTS_EXPORT_CONTAINER_PATH=""

readonly IMAGE SAM_IPC REPO_ROOT DEVHOME

content_mounts=()

usage() {
	printf 'Usage: %s <command> [arguments...]\n' "$(basename "$0")" >&2
}

quote_command() {
	local arg

	for arg in "$@"; do
		printf '%q ' "$arg"
	done
}

log_step() {
	local label=$1
	shift

	STEP_INDEX=$((STEP_INDEX + 1))
	printf '#%s [sam %s] %s\n' "${STEP_INDEX}" "${label}" "$(quote_command "$@")" >&2
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || {
		printf '[sam] required command not found: %s\n' "$1" >&2
		exit 127
	}
}

is_broad_mount_path() {
	local candidate=$1
	local relative=${candidate#/}

	[[ "${candidate}" == / || "${relative}" != */* ]] && return 0
	[[ "${REPO_ROOT}/" == "${candidate}/"* ]]
}

validate_mount_path() {
	local candidate=$1

	[[ "${candidate}" != *$'\n'* && "${candidate}" != *$'\r'* && "${candidate}" != *,* ]] || {
		printf '[sam] content mount path contains unsupported characters\n' >&2
		return 2
	}
	if is_broad_mount_path "${candidate}"; then
		printf '[sam] content links cannot mount a broad system, home, or repository ancestor\n' >&2
		return 2
	fi
	return 0
}

validate_comments_export() {
	local configured_path=${COMMENTS_EXPORT_PATH}
	local resolved_path
	local segment
	local -a segments=()

	[[ -n "${configured_path}" ]] || return 0
	require_command realpath
	[[ "${configured_path}" != /* && "${configured_path}" != *$'\n'* && "${configured_path}" != *$'\r'* && "${configured_path}" != *\\* && "${configured_path}" != *'//' && "${configured_path}" != */ ]] || {
		printf '[sam] FIREFLY_COMMENTS_EXPORT must be a repository-relative JSON path\n' >&2
		return 2
	}
	[[ "${configured_path}" == *.json ]] || {
		printf '[sam] FIREFLY_COMMENTS_EXPORT must name a JSON export\n' >&2
		return 2
	}
	IFS='/' read -r -a segments <<<"${configured_path}"
	for segment in "${segments[@]}"; do
		[[ -n "${segment}" && "${segment}" != '.' && "${segment}" != '..' ]] || {
			printf '[sam] FIREFLY_COMMENTS_EXPORT contains an unsafe path segment\n' >&2
			return 2
		}
	done
	resolved_path=$(realpath -e -- "${REPO_ROOT}/${configured_path}") || {
		printf '[sam] FIREFLY_COMMENTS_EXPORT does not resolve to an existing file\n' >&2
		return 2
	}
	[[ "${resolved_path}" == "${REPO_ROOT}/"* && -f "${resolved_path}" && -r "${resolved_path}" ]] || {
		printf '[sam] FIREFLY_COMMENTS_EXPORT must resolve to a readable file inside the repository\n' >&2
		return 2
	}
	COMMENTS_EXPORT_CONTAINER_PATH="/app/${configured_path}"
}

discover_content_mounts() {
	local configured_root=${FIREFLY_CONTENT_ROOT:-${REPO_ROOT}/content/posts}
	local content_root
	local current_directory
	local link_path
	local next_path
	local raw_target
	local target_path
	local -a directory_queue=()
	local queue_index=0
	local -A mounted_paths=()
	local -A scanned_directories=()
	local -A link_chain=()

	for dependency in find readlink realpath; do
		require_command "${dependency}"
	done
	[[ "${configured_root}" == /* ]] || {
		printf '[sam] FIREFLY_CONTENT_ROOT must be an absolute directory path\n' >&2
		return 2
	}
	validate_mount_path "${configured_root}"
	content_root=$(readlink -f -- "${configured_root}") || {
		printf '[sam] FIREFLY_CONTENT_ROOT cannot be resolved\n' >&2
		return 2
	}
	validate_mount_path "${content_root}"
	[[ -d "${content_root}" && -r "${content_root}" ]] || {
		printf '[sam] FIREFLY_CONTENT_ROOT must name a readable directory\n' >&2
		return 2
	}

	content_mounts+=(--mount "type=bind,src=${content_root},dst=${content_root},readonly")
	mounted_paths["${content_root}"]=1
	directory_queue+=("${content_root}")

	while ((queue_index < ${#directory_queue[@]})); do
		current_directory=${directory_queue[queue_index]}
		queue_index=$((queue_index + 1))
		[[ -z "${scanned_directories[${current_directory}]:-}" ]] || continue
		scanned_directories["${current_directory}"]=1

		while IFS= read -r -d '' link_path; do
			target_path=${link_path}
			link_chain=()
			while [[ -L "${target_path}" ]]; do
				[[ -z "${link_chain[${target_path}]:-}" ]] || {
					printf '[sam] cyclic content symlink below the configured workspace\n' >&2
					return 2
				}
				link_chain["${target_path}"]=1
				raw_target=$(readlink -- "${target_path}") || {
					printf '[sam] unreadable content symlink below the configured workspace\n' >&2
					return 2
				}
				if [[ "${raw_target}" == /* ]]; then
					next_path=$(realpath -ms -- "${raw_target}")
				else
					next_path=$(realpath -ms -- "$(dirname -- "${target_path}")/${raw_target}")
				fi
				validate_mount_path "${next_path}"
				[[ -e "${next_path}" || -L "${next_path}" ]] || {
					printf '[sam] broken content symlink below the configured workspace\n' >&2
					return 2
				}
				if [[ -z "${mounted_paths[${next_path}]:-}" ]]; then
					content_mounts+=(--mount "type=bind,src=${next_path},dst=${next_path},readonly")
					mounted_paths["${next_path}"]=1
				fi
				target_path=${next_path}
			done
			[[ -f "${target_path}" || -d "${target_path}" ]] || {
				printf '[sam] content symlink target must be a regular file or directory\n' >&2
				return 2
			}
			if [[ -d "${target_path}" && "${link_path}/" == "${target_path}/"* ]]; then
				printf '[sam] cyclic content directory link below the configured workspace\n' >&2
				return 2
			fi
			[[ -d "${target_path}" ]] && directory_queue+=("${target_path}")
		done < <(find "${current_directory}" -type l -print0)
	done

	FIREFLY_CONTENT_ROOT=${content_root}
	export FIREFLY_CONTENT_ROOT
}

run_step() {
	local label=$1
	shift

	log_step "${label}" "$@"
	"$@"
}

main() {
	local -a tty_flags=()
	local -a port_flags=()
	local -a environment_flags=()
	local -a config_mount_flags=()
	local -a docker_command
	local -a comments_environment_names=(
		COMMENTS_CONFIG_PATH
		COMMENTS_SMTP_HOST
		COMMENTS_SMTP_PORT
		COMMENTS_SMTP_SECURE
		COMMENTS_SMTP_USER
		COMMENTS_SMTP_PASSWORD
		COMMENTS_SMTP_FROM
		COMMENTS_SMTP_FROM_NAME
		COMMENTS_SMTP_CONNECT_TIMEOUT_MS
		COMMENTS_SMTP_COMMAND_TIMEOUT_MS
		COMMENTS_PUBLIC_ORIGIN
		COMMENTS_OUTBOX_PATH
		COMMENTS_OUTBOX_STATE_PATH
		COMMENTS_CONSENT_VERSION
	)
	local env_name

	[[ $# -gt 0 ]] || {
		usage
		return 2
	}

	validate_comments_export
	require_command docker
	require_command id
	require_command mkdir
	discover_content_mounts
	run_step internal mkdir -p -- "${DEVHOME}"

	[[ -t 0 ]] && tty_flags+=(-i)
	[[ -t 0 && -t 1 ]] && tty_flags+=(-t)

	case "${SAM_IPC}" in
	private | host) ;;
	*)
		printf '[sam] unsupported IPC mode: %s (expected private or host)\n' "${SAM_IPC}" >&2
		return 2
		;;
	esac

	case "${SAM_SERVICE:-}" in
	"") ;;
	web)
		port_flags=(-p "${SAM_BIND_HOST}:${WEB_HOST_PORT}:${WEB_CONTAINER_PORT}")
		;;
	*)
		printf '[sam] unknown service for port mapping: %s\n' "${SAM_SERVICE}" >&2
		return 2
		;;
	esac

	if [[ -n "${COMMENTS_EXPORT_CONTAINER_PATH}" ]]; then
		environment_flags=(-e "FIREFLY_COMMENTS_EXPORT=${COMMENTS_EXPORT_CONTAINER_PATH}")
	fi
	if [[ -f "${REPO_ROOT}/config/site.toml" ]]; then
		config_mount_flags=(--mount "type=bind,src=${REPO_ROOT}/config/site.toml,dst=/app/config/site.toml,readonly")
	fi
	for env_name in "${comments_environment_names[@]}"; do
		[[ -n "${!env_name-}" ]] && environment_flags+=(-e "${env_name}")
	done
	docker_command=(
		docker run --rm --init
		"${tty_flags[@]}"
		--ipc "${SAM_IPC}"
		--user "$(id -u):$(id -g)"
		-e HOME=/app/.devhome
		-e "FIREFLY_CONTENT_ROOT=${FIREFLY_CONTENT_ROOT}"
		"${environment_flags[@]}"
		-v "${REPO_ROOT}:/app"
		"${config_mount_flags[@]}"
		"${content_mounts[@]}"
		-w /app
		--label "sam.repo=${REPO_ROOT}"
		--label "sam.scope=${SAM_SCOPE:-manual}"
		--label "sam.service=${SAM_SERVICE:-}"
		"${port_flags[@]}"
		"${IMAGE}"
		"$@"
	)

	log_step run "${docker_command[@]}"
	exec "${docker_command[@]}"
}

main "$@"
